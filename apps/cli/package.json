{
  "name": "@assay/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ASSAY command line — the only package that touches the filesystem; acquires source data and drives the already-built pipeline",
  "license": "UNLICENSED",
  "bin": {
    "assay": "./src/main.ts"
  },
  "exports": {
    ".": {
