      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@assay/domain": "workspace:*",
    "@assay/engine": "workspace:*",
    "@assay/eval": "workspace:*",
    "@assay/generator": "workspace:*",
    "@assay/ledger": "workspace:*",
    "@assay/llm": "workspace:*",
    "@assay/money": "workspace:*",
    "@assay/oracle": "workspace:*",
    "@assay/probe": "workspace:*"
  }
}
