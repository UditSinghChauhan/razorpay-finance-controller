{
  "name": "@assay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ASSAY internal HTTP — thin HTTP over engine + ledger, consumed only by apps/web, local bind only",
  "license": "UNLICENSED",
  "bin": {
    "assay-api": "./bin/assay-api.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "node --experimental-transform-types --disable-warning=ExperimentalWarning bin/assay-api.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "@assay/cli": "workspace:*",
    "@assay/controller": "workspace:*",
    "@assay/domain": "workspace:*",
    "@assay/ledger": "workspace:*",
    "@assay/llm": "workspace:*",
    "@google/genai": "2.21.0",
    "@hono/node-server": "2.1.1",
    "hono": "4.10.7",
    "zod": "4.4.3"
  }
}
