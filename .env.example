# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# LLM provider. ASSAY runs fully without any of this: `offline` needs nothing.
#   offline            deterministic rule-based roles, no network, zero cost
#   replay             committed response cache, no network, zero cost
#   anthropic          metered Anthropic API
#   openai-compatible  any endpoint speaking the OpenAI chat-completions schema
#   gemini             Google Gemini Developer API via @google/genai
#
# The CLI REFUSES every networked provider outright, whatever is set here: a
# scored run may not incur spend and may not depend on a live model. These ids
# are the pipeline's; the product explanation surface has its own block below.
# ---------------------------------------------------------------------------
ASSAY_LLM_PROVIDER=offline
ASSAY_LLM_MODEL_ID=rules-v1
ASSAY_STRICT_REPLAY=true

# Only needed when ASSAY_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Only needed when ASSAY_LLM_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# NOTE: consumer subscriptions (Claude Pro, ChatGPT Go, Google AI Pro, etc.) are
# NOT API credentials and must never be used here. See docs/ARCHITECTURE.md §6.5.

# ---------------------------------------------------------------------------
# "Explain with AI" — apps/api's product explanation surface (role R4).
#
# Read ONLY by the API process. apps/web never sees any of this: the browser
# calls POST /runs/:id/decisions/:decision_id/explain and the server owns the
# credential and the provider choice. The request body carries presentation
# preferences and nothing else — it cannot name a provider, a model or a key.
#
# With no credential set the endpoint answers 503 with MISSING_CREDENTIAL and a
# deterministic "Evidence summary — AI unavailable" built from the sealed
# decision, while every other route, the certificate and the ledger are
# completely unaffected — the repository still runs from a clean checkout with
# no API key.
#
#   anthropic  (default)  ANTHROPIC_API_KEY + ASSAY_EXPLAIN_MODEL_ID
#   gemini                GEMINI_API_KEY    + GEMINI_MODEL
#
# Each provider reads ONLY its own credential; there is no fall-through to
# whichever key happens to be set. The default is left at `anthropic` so an
# upgrade never moves an operator's spend without their saying so.
# ---------------------------------------------------------------------------
ASSAY_EXPLAIN_PROVIDER=anthropic
ASSAY_EXPLAIN_MAX_TOKENS=2000
ASSAY_EXPLAIN_TIMEOUT_MS=60000

# --- ASSAY_EXPLAIN_PROVIDER=anthropic --------------------------------------
ASSAY_EXPLAIN_MODEL_ID=claude-opus-5
# ANTHROPIC_API_KEY above is the credential this surface uses.
# ANTHROPIC_BASE_URL is the SDK's own transport override; leave it unset in
# normal use.
ANTHROPIC_BASE_URL=

# --- ASSAY_EXPLAIN_PROVIDER=gemini -----------------------------------------
#
# The Gemini Developer API key, from Google AI Studio. Leave EMPTY here and set
# it in your own .env, which is gitignored. NEVER commit a value.
GEMINI_API_KEY=
# A Flash-family model, which is what this surface's single short call wants.
# Defaults to gemini-2.5-flash when unset.
GEMINI_MODEL=gemini-2.5-flash
# The SDK's own transport override; leave unset in normal use.
GEMINI_BASE_URL=

# ---------------------------------------------------------------------------
# Razorpay Test Mode. Read-only calibration only; ASSAY never writes to Razorpay.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ASSAY_DB_PATH=./runs/assay.sqlite
