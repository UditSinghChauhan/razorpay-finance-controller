# Exact, pinned dependency versions.
#
# EVALUATION_SPEC.md §7 names "pinned dependencies (pnpm-lock.yaml)" as one of
# the guarantees that a third party can reproduce every number in the report.
# A caret range would let a transitive upgrade change behaviour between the
# sealed run and a reviewer's re-run, so ranges are not used at all.
save-exact=true

# Refuse to install under a runtime the workspace does not declare support for.
# DECISION_BRIEF.md §J fixes Node 22; ARCHITECTURE.md §11 fixes it alongside
# TypeScript 5.x as the single toolchain for every package.
engine-strict=true
